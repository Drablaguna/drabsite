---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/starwind/button.astro";
import Card from "../../components/starwind/card.astro";
import CardHeader from "../../components/starwind/card-header.astro";
import CardTitle from "../../components/starwind/card-title.astro";
import CardDescription from "../../components/starwind/card-description.astro";
import CardContent from "../../components/starwind/card-content.astro";
import { useTranslations } from "../../i18n/utils";
import { languages } from "../../i18n/ui";

export function getStaticPaths() {
	return [{ params: { lang: "en" } }, { params: { lang: "pt" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<BaseLayout>
	<!-- Hero Section -->
	<section class='relative py-20 overflow-hidden bg-slate-950 text-white'>
		<div class='absolute inset-0 bg-gradient-to-br from-primary/20 to-transparent'></div>
		<div class='container mx-auto px-4 relative z-10 flex flex-col items-center text-center'>
			<h1 class='text-4xl md:text-6xl font-extrabold tracking-tight mb-6 max-w-4xl'>
				{t("hero.title")}
			</h1>
			<p class='text-xl md:text-2xl text-slate-300 mb-10 max-w-2xl'>
				{t("hero.subtitle")}
			</p>
			<div class='flex flex-col sm:flex-row gap-4'>
				<Button href='#contact' size='lg' class='rounded-full px-8'>
					{lang === "en" ? "Let's work together!" : "Vamos trabalhar juntos!"}
				</Button>
				<Button
					href='#about'
					variant='outline'
					size='lg'
					class='rounded-full px-8 text-white border-white/20 hover:bg-white/10'
				>
					{t("hero.cta")}
				</Button>
			</div>
		</div>
	</section>

	<!-- Services Section -->
	<section id='services' class='py-24 bg-background'>
		<div class='container mx-auto px-4'>
			<div class='text-center mb-16'>
				<h2 class='text-3xl md:text-5xl font-bold mb-4'>{t("services.title")}</h2>
				<p class='text-muted-foreground text-lg max-w-2xl mx-auto'>
					{
						lang === "en"
							? "I offer high-level creative and technological solutions for brands looking to stand out."
							: "Ofereço soluções criativas e tecnológicas de alto nível para marcas que buscam se destacar."
					}
				</p>
			</div>

			<div class='grid grid-cols-1 md:grid-cols-3 gap-8'>
				<!-- Web Design -->
				<Card
					class='group hover:border-primary/50 transition-all duration-300 hover:shadow-2xl hover:shadow-primary/5'
				>
					<CardHeader>
						<div
							class='w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors'
						>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='24'
								height='24'
								viewBox='0 0 24 24'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								><path d='M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z'></path></svg
							>
						</div>
						<CardTitle>{t("services.web.title")}</CardTitle>
						<CardDescription>{t("services.web.desc")}</CardDescription>
					</CardHeader>
				</Card>

				<!-- AI Automation -->
				<Card
					class='group hover:border-primary/50 transition-all duration-300 hover:shadow-2xl hover:shadow-primary/5'
				>
					<CardHeader>
						<div
							class='w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors'
						>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='24'
								height='24'
								viewBox='0 0 24 24'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								><path d='M12 2a10 10 0 1 0 10 10H12V2z'></path><path d='M12 12L2.1 14.9'></path><path
									d='M12 12l9.9 2.9'></path><path d='M12 12l2.9 9.9'></path><path d='M12 12l-2.9 9.9'
								></path></svg
							>
						</div>
						<CardTitle>{t("services.ai.title")}</CardTitle>
						<CardDescription>{t("services.ai.desc")}</CardDescription>
					</CardHeader>
				</Card>

				<!-- Video -->
				<Card
					class='group hover:border-primary/50 transition-all duration-300 hover:shadow-2xl hover:shadow-primary/5'
				>
					<CardHeader>
						<div
							class='w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors'
						>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='24'
								height='24'
								viewBox='0 0 24 24'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								><rect x='2' y='2' width='20' height='20' rx='2.18' ry='2.18'></rect><line
									x1='7'
									y1='2'
									x2='7'
									y2='22'></line><line x1='17' y1='2' x2='17' y2='22'></line><line
									x1='2'
									y1='12'
									x2='22'
									y2='12'></line><line x1='2' y1='7' x2='7' y2='7'></line><line
									x1='2'
									y1='17'
									x2='7'
									y2='17'></line><line x1='17' y1='17' x2='22' y2='17'></line><line
									x1='17'
									y1='7'
									x2='22'
									y2='7'></line></svg
							>
						</div>
						<CardTitle>{t("services.video.title")}</CardTitle>
						<CardDescription>{t("services.video.desc")}</CardDescription>
					</CardHeader>
				</Card>
			</div>
		</div>
	</section>

	<!-- Testimonials/KPIs -->
	<section id='results' class='py-24 bg-muted/30'>
		<div class='container mx-auto px-4'>
			<div class='grid grid-cols-1 md:grid-cols-3 gap-12 text-center'>
				<div class='space-y-4'>
					<div class='text-5xl font-black text-primary'>+45%</div>
					<p class='text-lg font-medium text-muted-foreground uppercase tracking-widest'>
						{lang === "en" ? "Web Conversion" : "Conversão Web"}
					</p>
					<p class='text-sm italic'>
						{
							lang === "en"
								? '"Tangible results in the first 3 months."'
								: '"Resultados tangíveis nos primeiros 3 meses."'
						}
					</p>
				</div>
				<div class='space-y-4'>
					<div class='text-5xl font-black text-primary'>80%</div>
					<p class='text-lg font-medium text-muted-foreground uppercase tracking-widest'>
						{lang === "en" ? "Operational Efficiency" : "Eficiência Operacional"}
					</p>
					<p class='text-sm italic'>
						{
							lang === "en"
								? '"Massive reduction of manual tasks with AI."'
								: '"Redução massiva de tarefas manuais com IA."'
						}
					</p>
				</div>
				<div class='space-y-4'>
					<div class='text-5xl font-black text-primary'>+200%</div>
					<p class='text-lg font-medium text-muted-foreground uppercase tracking-widest'>
						{lang === "en" ? "Social Engagement" : "Engajamento Social"}
					</p>
					<p class='text-sm italic'>
						{
							lang === "en"
								? '"Visual storytelling that connects with the audience."'
								: '"Storytelling visual que conecta com a audiência."'
						}
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact Section -->
	<section id='contact' class='py-24 bg-background'>
		<div class='container mx-auto px-4 max-w-4xl'>
			<Card class='border shadow-2xl relative overflow-hidden'>
				<div class='absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-bl-full'></div>
				<CardHeader class='text-center'>
					<CardTitle class='text-3xl font-bold'>
						{lang === "en" ? "Ready to transform your business?" : "Pronto para transformar seu negócio?"}
					</CardTitle>
					<CardDescription>
						{
							lang === "en"
								? "Write to me and let's make your digital vision a reality."
								: "Escreva-me e vamos tornar sua visão digital uma realidade."
						}
					</CardDescription>
				</CardHeader>
				<CardContent>
					<form class='grid grid-cols-1 md:grid-cols-2 gap-6'>
						<div class='space-y-2'>
							<label for='name' class='text-sm font-medium'>{lang === "en" ? "Name" : "Nome"}</label>
							<input
								type='text'
								id='name'
								class='w-full px-4 py-2 rounded-lg border bg-background focus:ring-2 focus:ring-primary/20 outline-none transition-all'
								placeholder={lang === "en" ? "Your name" : "Seu nome"}
							/>
						</div>
						<div class='space-y-2'>
							<label for='email' class='text-sm font-medium'>Email</label>
							<input
								type='email'
								id='email'
								class='w-full px-4 py-2 rounded-lg border bg-background focus:ring-2 focus:ring-primary/20 outline-none transition-all'
								placeholder='email@example.com'
							/>
						</div>
						<div class='space-y-2 md:col-span-2'>
							<label for='message' class='text-sm font-medium'
								>{lang === "en" ? "Message" : "Mensagem"}</label
							>
							<textarea
								id='message'
								rows='4'
								class='w-full px-4 py-2 rounded-lg border bg-background focus:ring-2 focus:ring-primary/20 outline-none transition-all'
								placeholder={lang === "en"
									? "Tell me about your project..."
									: "Conte-me sobre seu projeto..."}></textarea>
						</div>
						<div class='md:col-span-2 text-center'>
							<Button type='submit' size='lg' class='w-full md:w-auto px-12 rounded-full'>
								{lang === "en" ? "Send Message" : "Enviar Mensagem"}
							</Button>
						</div>
					</form>
				</CardContent>
			</Card>
		</div>
	</section>
</BaseLayout>
